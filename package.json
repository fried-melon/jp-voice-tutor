{
  "name": "jp-voice-tutor",
  "version": "0.3.0-voice-start.1",
  "private": true,
  "type": "module",
  "scripts": {
    "sync-content": "node scripts/sync-content.mjs",
    "predev": "npm run sync-content",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run sync-content",
    "build": "node scripts/assert-build-env.mjs && node scripts/verify-assets.mjs && tsc --noEmit && vite build && node scripts/verify-production-bundle.mjs && node scripts/build-worker.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test --experimental-strip-types tests/*.test.mjs",
    "test:browser": "node tests/browser/lifecycle-e2e.mjs",
    "build:worker": "node scripts/build-worker.mjs"
  },
  "dependencies": {
    "@google/genai": "2.31.0",
    "google-auth-library": "10.5.0",
    "jose": "6.1.3",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "playwright-core": "^1.64.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}